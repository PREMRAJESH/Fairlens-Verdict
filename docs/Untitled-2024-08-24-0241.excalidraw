      "updated": 1782286483023,
      "link": null,
      "locked": false,
      "text": "\"text\": \"🛠  tools/flag_bias.py\\n\\n_store: dict[session_id → list[dict]]\\n(module-level\nsingleton)\\n\\nflag_bias(bias_type, quote, agent_name,\\n          severity, explanation,\\n\ncorrective_reframe)\\n  → { \\\"status\\\": \\\"flagged\\\" }\\n\\nstore_flag(session_id,\nflag)\\nget_flags(session_id)\\nget_auditor_summary(session_id,\\n\nchanged_from_raw?)\\n  score = 100 − (H×15 + M×7 + L×3)\\nclear_session(session_id)\",",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"text\": \"🛠  tools/flag_bias.py\\n\\n_store: dict[session_id → list[dict]]\\n(module-level singleton)\\n\\nflag_bias(bias_type, quote, agent_name,\\n          severity, explanation,\\n          corrective_reframe)\\n  → { \\\"status\\\": \\\"flagged\\\" }\\n\\nstore_flag(session_id, flag)\\nget_flags(session_id)\\nget_auditor_summary(session_id,\\n    changed_from_raw?)\\n  score = 100 − (H×15 + M×7 + L×3)\\nclear_session(session_id)\",",
      "autoResize": false,
      "lineHeight": 1.25
    },
