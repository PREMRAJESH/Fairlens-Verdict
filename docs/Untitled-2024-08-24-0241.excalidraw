      "updated": 1782286483022,
      "link": null,
      "locked": false,
      "text": "\"text\": \"LlmAgent  \\\"BiasAuditor\\\"\\nagents/auditor.py\\n\\nplanner: BuiltInPlanner\\n\nThinkingConfig(thinking_budget=1024)\\n\\ntool: flag_bias_tool =\nFunctionTool(flag_bias)\\n  flag_bias(bias_type, quote, agent_name,\\n            severity,\nexplanation,\\n            corrective_reframe)\\n  → store_flag(session_id, flag)\\n  → emit\n\\\"bias_flag\\\" SSE\\n\\noutput_key: \\\"bias_report\\\"\\non is_final → get_auditor_summary()\\n\n→ emit \\\"auditor_summary\\\"\",",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"text\": \"LlmAgent  \\\"BiasAuditor\\\"\\nagents/auditor.py\\n\\nplanner: BuiltInPlanner\\n  ThinkingConfig(thinking_budget=1024)\\n\\ntool: flag_bias_tool = FunctionTool(flag_bias)\\n  flag_bias(bias_type, quote, agent_name,\\n            severity, explanation,\\n            corrective_reframe)\\n  → store_flag(session_id, flag)\\n  → emit \\\"bias_flag\\\" SSE\\n\\noutput_key: \\\"bias_report\\\"\\non is_final → get_auditor_summary()\\n           → emit \\\"auditor_summary\\\"\",",
      "autoResize": false,
      "lineHeight": 1.25
    },
