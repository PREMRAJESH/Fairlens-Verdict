      "updated": 1782286483023,
      "link": null,
      "locked": false,
      "text": "\"text\": \"SSE EVENT TYPES  (emitted via sse_queue → StreamingResponse →\nuseBackendRuntime.handleEvent)\\npipeline_start { provider }   agent_start { agent }\ntranscript_chunk { agent, text }   agent_verdict { agent, position, justification }\\nbias_flag\n{ agent_name, bias_type, quote, severity, explanation, corrective_reframe }\nauditor_summary { total_flags, high/medium/low_severity_count, most_biased_agent,\ndominant_bias_types, confidence_score }\\nfinal_verdict { session_id, raw_verdict,\nbias_summary, debiased_verdict, final_recommendation }   agent_done { agent }   error {\nmessage, agent }   done { session_id }\",",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"text\": \"SSE EVENT TYPES  (emitted via sse_queue → StreamingResponse → useBackendRuntime.handleEvent)\\npipeline_start { provider }   agent_start { agent }   transcript_chunk { agent, text }   agent_verdict { agent, position, justification }\\nbias_flag { agent_name, bias_type, quote, severity, explanation, corrective_reframe }   auditor_summary { total_flags, high/medium/low_severity_count, most_biased_agent, dominant_bias_types, confidence_score }\\nfinal_verdict { session_id, raw_verdict, bias_summary, debiased_verdict, final_recommendation }   agent_done { agent }   error { message, agent }   done { session_id }\",",
      "autoResize": false,
      "lineHeight": 1.25
    },
