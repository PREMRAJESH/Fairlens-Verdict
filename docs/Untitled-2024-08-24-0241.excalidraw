      "isDeleted": true,
      "boundElements": null,
      "updated": 1782286483023,
      "link": null,
      "locked": false,
      "text": "\"text\": \"⚡ Provider Fallback\\nmodels/provider.py\\n\\nresolve_provider()\\n  \"gemini\" →\ngoogle.adk Runner\\n  \"grok\"   → run_grok_pipeline()\\n  \"groq\"   →\nrun_groq_pipeline()\\n\\nOn ADK exception:\\n  grok_available()? → Grok\\n\ngroq_available()? → Groq\\n  else              → error + done\",",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"text\": \"⚡ Provider Fallback\\nmodels/provider.py\\n\\nresolve_provider()\\n  \"gemini\" → google.adk Runner\\n  \"grok\"   → run_grok_pipeline()\\n  \"groq\"   → run_groq_pipeline()\\n\\nOn ADK exception:\\n  grok_available()? → Grok\\n  groq_available()? → Groq\\n  else              → error + done\",",
      "autoResize": false,
      "lineHeight": 1.25
    },
